{
    "name": "park-ops",
    "private": true,
    "version": "0.0.1",
    "description": "ParkOps monorepo — NestJS backend + Next.js frontend",
    "engines": {
        "node": ">=22.13"
    },
    "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
    "scripts": {
        "dev": "concurrently -n api,web -c blue,green \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
        "build": "pnpm -r run build",
        "lint": "pnpm -r run lint",
        "typecheck": "pnpm -r run typecheck",
        "format:check": "pnpm -r run format:check && prettier --check \"*.{js,ts,mjs,json,md,yml,yaml}\" \".*.{js,ts,mjs,json,md,yml,yaml}\"",
        "format:fix": "pnpm -r run format:fix && prettier --write \"*.{js,ts,mjs,json,md,yml,yaml}\" \".*.{js,ts,mjs,json,md,yml,yaml}\"",
        "db:start": "docker compose up -d --wait",
        "db:stop": "docker compose down",
        "db:reset": "docker compose down -v && docker compose up -d --wait && (success=0; for i in 1 2 3 4 5; do pnpm db:migrate && success=1 && break || sleep 2; done; test \"$success\" = 1)",
        "db:generate": "pnpm --filter api db:generate",
        "db:migrate": "pnpm --filter api db:migrate",
        "db:seed": "pnpm --filter api db:seed",
        "db:studio": "pnpm --filter api db:studio"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "prettier": "^3.9.4"
    }
}
