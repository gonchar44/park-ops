# --- Local Docker Compose Postgres/PostGIS (docker-compose.yml) ---
POSTGRES_USER=parkops
POSTGRES_PASSWORD=parkops
POSTGRES_DB=parkops
POSTGRES_PORT=5434

# --- apps/api ---
# Local Docker Compose connection (default):
DATABASE_URL=postgres://parkops:parkops@localhost:5434/parkops

# Neon connection (staging/prod) - copy from the Neon dashboard, keep sslmode=require:
# DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

PORT=3001
